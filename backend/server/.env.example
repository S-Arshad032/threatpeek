# Copy to backend/server/.env and fill in. Never commit .env.

# Port the server listens on (default 3001).
PORT=

# Comma-separated list of origins allowed by CORS (default http://localhost:5173).
ALLOWED_ORIGINS=

# Google Safe Browsing Lookup API v4 key. Empty = the /api/safebrowsing layer is off.
GOOGLE_SAFE_BROWSING_KEY=

# Set to "true" to enable the AI (L3) layer. Anything else = off.
AI_ENABLED=

# One OpenRouter API key. Empty = the AI layer is off.
OPENROUTER_API_KEY=

# OpenRouter model id of your choice, e.g. a free model such as "<vendor>/<model>:free".
OPENROUTER_MODEL=

# Maximum OpenRouter calls per UTC day (default 40, below the free tier limit of 50).
AI_DAILY_LIMIT=
