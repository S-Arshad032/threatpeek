# Copy to backend/server/.env and fill in. Never commit .env or real keys.
# On a host, set these in the host's environment settings instead of a file.
# Empty or invalid values fall back to the safe default.

# Port the server listens on (default 3001). Most hosts set PORT for you.
PORT=

# "production" serves the built frontend and adds HSTS (default development).
# The root "npm start" sets it to production for you.
NODE_ENV=

# How many reverse proxies sit in front of the app, e.g. 1 (default: empty = trust none).
# Only set it when the app really runs behind a proxy or load balancer; otherwise clients
# could fake their IP. A list of proxy IPs/subnets also works, e.g. "loopback, 10.0.0.0/8".
# "true" is refused on purpose.
TRUST_PROXY=

# Folder with the built frontend (default ../../frontend/dist, relative to backend/server/).
# Setting it also turns on static hosting outside production.
STATIC_DIR=

# Comma-separated list of OTHER origins allowed by CORS (default http://localhost:5173).
# Not needed when the frontend is served by this server (same origin).
ALLOWED_ORIGINS=

# Google Safe Browsing Lookup API v4 key (optional). Empty = the /api/safebrowsing layer is off.
GOOGLE_SAFE_BROWSING_KEY=

# Set to "true" to enable the AI (L3) layer (default false). Anything else = off.
AI_ENABLED=false

# One OpenRouter API key (optional). Empty = the AI layer is off.
OPENROUTER_API_KEY=

# OpenRouter model id of your choice, e.g. a free model such as "<vendor>/<model>:free".
OPENROUTER_MODEL=

# Maximum OpenRouter calls per UTC day (default 40, below the free tier limit of 50).
AI_DAILY_LIMIT=
